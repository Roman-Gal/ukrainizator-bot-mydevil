TELEGRAM_BOT_TOKEN=
WEBHOOK_SECRET=
# Shared tunnel mode uses /translator/telegram/webhook; standalone uses /telegram/webhook.
# Leave empty to allow every chat where the bot is added.
ALLOWED_CHAT_IDS=
# Local LibreTranslate. Start scripts/start-libretranslate.ps1 first.
# disabled: help/status only; http: adapter contract; libretranslate: native API.
# deepl: official API, e.g. https://api-free.deepl.com/v2/translate plus API key.
API_TIMEOUT_SECONDS=60
RUSSIAN_JOKES_ENABLED=true
RUSSIAN_CONFIDENCE=0.75
RUSSIAN_MIN_LETTERS=3
JOKE_COOLDOWN_SECONDS=0
PUBLIC_BASE_URL=https://YOUR_HOSTNAME
PUBLIC_WEBHOOK_PATH=/translator/telegram/webhook
HOST=127.0.0.1
PORT=18381
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@pgsql93.mydevil.net:5432/DB?sslmode=disable
TRANSLATION_PROVIDER=deepl
TRANSLATION_API_URL=https://api-free.deepl.com/v2/translate
TRANSLATION_API_KEY=REPLACE_ME
